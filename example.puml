' Use Case Diagram Example
title "E-Commerce System Use Cases"

left to right direction

actor Customer
actor Admin
actor "Payment System" as Payment

package "E-Commerce System" {
    usecase "Browse Products" as UC1
    usecase "Search Products" as UC2
    usecase "Add to Cart" as UC3
    usecase "Place Order" as UC4
    usecase "Make Payment" as UC5
    usecase "Track Order" as UC6
    usecase "Manage Products" as UC7
    usecase "View Reports" as UC8
    usecase "Process Refunds" as UC9
}

' Customer use cases
Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6

' Admin use cases
Admin --> UC7
Admin --> UC8
Admin --> UC9

' System interactions
UC5 --> Payment : <<include>>
UC4 ..> UC3 : <<extend>>

