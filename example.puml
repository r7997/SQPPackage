@startuml Example UML Diagrams

' Class Diagram Example
package "E-Commerce System" {
    class User {
        -id: Long
        -username: String
        -email: String
        -password: String
        +login(username, password): boolean
        +register(): void
        +updateProfile(): void
    }

    class Product {
        -id: Long
        -name: String
        -price: Double
        -description: String
        -stock: Integer
        +getPrice(): Double
        +updateStock(quantity): void
        +isAvailable(): boolean
    }

    class Order {
        -id: Long
        -orderDate: Date
        -status: OrderStatus
        -totalAmount: Double
        +calculateTotal(): Double
        +addItem(product, quantity): void
        +removeItem(product): void
        +processPayment(): boolean
    }

    class OrderItem {
        -quantity: Integer
        -unitPrice: Double
        +getSubtotal(): Double
    }

    enum OrderStatus {
        PENDING
        CONFIRMED
        SHIPPED
        DELIVERED
        CANCELLED
    }

    ' Relationships
    User ||--o{ Order : places
    Order ||--o{ OrderItem : contains
    Product ||--o{ OrderItem : includes
    Order ||-- OrderStatus
}

