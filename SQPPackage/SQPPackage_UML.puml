@startuml SQPPackage_Architecture

!theme blueprint
title SQPPackage.jl - UML Klassendiagramm

package "SQPPackage" {
    
    ' Main Package Module
    class SQPPackage {
        +sqp_method()
        +solve_with_ipopt_adnlp()
    }

    ' Settings Module
    package "SettingsModule" {
        class Settings {
            -max_iter: Int = 200
            -tol: Float64 = 1e-8
            -verbose: Bool = false
            -regularization: Float64 = 1e-8
            -min_eigenvalue: Float64 = 1e-8
            -use_regularization: Bool = true
            -hessian_convexification: Symbol = :lm
            -epsilon: Float64 = 1e-8
            -use_globalization: Bool = true
            -use_advanced_termination: Bool = false
            -use_soc: Bool = false
            -soc_improvement_threshold: Float64 = 0.5
            -hmax_factor: Float64 = 1.0
            -hmin_factor: Float64 = 1e-4
            -γh: Float64 = 1e-5
            -γf: Float64 = 1e-5
            -δ: Float64 = 1.0
            -γα: Float64 = 0.05
            -sh: Float64 = 1.1
            -sf: Float64 = 2.3
            -ηf: Float64 = 1e-4
            -qp_solver: Symbol = :osqp
            -osqp_settings: Dict
            -clarabel_settings: Dict
            -benchmark: Bool = false
            -benchmark_file: String
            --
            +Settings()
        }
    }

    ' Stats Module
    package "StatsModule" {
        enum SQPStatus {
            kkt_point
            max_iter
            qp_failed
            unbounded
            infeasible
            restoration_phase
        }

        class Stats {
            +x: Vector{Float64}
            +y: Vector{Float64}
            +z: Vector{Float64}
            +obj_val: Float64
            +inf_pr: Float64
            +inf_du: Float64
            +inf_comp: Float64
            +qp_status: SQPStatus
            +sqp_status: SQPStatus
            +iter: Int
            +obj_evals: Int
            +grad_evals: Int
            +cons_evals: Int
            +jac_evals: Int
            +hess_evals: Int
            +qp_solve_status: Symbol
            +total_time: Float64
            +x_prev: Vector{Float64}
            +iteration_data: Vector{Any}
            --
            +Stats(x, y, z, obj_val, inf_pr, inf_du, inf_comp, qp_status, sqp_status, iter)
        }
    }

    ' SQP Method Module
    package "SQPMethod" {
        class IterationData {
            +iter: Int
            +objective: Float64
            +inf_pr: Float64
            +inf_du: Float64
            +inf_comp: Float64
            +step_norm: Float64
            +alpha: Float64
            +type: String
            +ls: Int
        }

        class SOCResult {
            +d_soc: Vector{Float64}
            +success: Bool
            +qp_status: Symbol
        }

        class SQPMethodCore {
            +sqp_method(nlp, settings)
            +compute_soc_step()
            -main_iteration_loop()
            -check_convergence()
            -update_variables()
        }
    }

    ' QP Interface Module
    package "QPInterface" {
        abstract class AbstractQPSolver {
            {abstract} +solve()
        }

        class ClarabelSolver {
            +solver: Any
            +settings: Any
            +problem_data: Dict{String, Any}
            +n: Int
            +m: Int
        }

        class OSQPSolver {
            +solver: Any
            +settings: Any
            +problem_data: Dict{String, Any}
            +n: Int
            +m: Int
        }

        class QuadraticModelsSolver {
            +solver_type: Symbol
            +qp_model: Any
            +solver: Any
            +n: Int
            +m: Int
        }

        class QPResult {
            +x: Vector{Float64}
            +y: Vector{Float64}
            +zL: Vector{Float64}
            +zU: Vector{Float64}
            +status: Symbol
            +solve_time: Float64
            +iterations: Int
        }

        class QPInterfaceCore {
            +create_qp_solver(settings)
            +solve_qp(solver, H, g, A, b, C, l, u)
        }
    }

    ' Filter Line Search Module
    package "FilterLineSearchSQP" {
        class FilterPoint {
            +h: Float64
            +f: Float64
        }

        class Filter {
            +points: Vector{FilterPoint}
            --
            +Filter()
        }

        class FilterLineSearchCore {
            +filter_line_search()
            +add_to_filter!(filter, h, f)
            +remove_dominated_points!(filter)
            +is_acceptable_to_filter()
            +constraint_violation()
        }
    }

    ' Convexify Module
    package "ConvexifyModule" {
        class ConvexifyCore {
            +convexify_hessian!(H, strategy)
            +convexify_hessian(H, strategy)
            -apply_levenberg_marquardt()
            -apply_projection()
            -apply_mirror()
            -apply_gershgorin()
        }
    }

    ' Residuals Module
    package "ResidualsModule" {
        class ResidualsCore {
            +compute_kkt_residuals()
            +get_primal_residual()
            +get_dual_residual()
        }
    }

    ' Problem Types Module
    package "ProblemTypes" {
        abstract class AbstractNLPModel
        class OptimizationProblem
    }

    ' Benchmarking Module
    package "Benchmarking" {
        class BenchmarkingCore {
            +performance_profile()
            +run_benchmark()
            +benchmark_solver()
        }
    }

    ' Test Problems Module
    package "SQPTestProblems" {
        class TestProblemsCore {
            +create_P1() to +create_P16()
        }
    }

    ' External Solvers
    package "External Solvers" <<Cloud>> {
        class OSQP <<external>>
        class Clarabel <<external>>
        class Ipopt <<external>>
        class MadNLP <<external>>
    }

    ' External Libraries
    package "External Libraries" <<Cloud>> {
        class NLPModels <<external>>
        class ADNLPModels <<external>>
        class LinearAlgebra <<external>>
        class SparseArrays <<external>>
    }
}

' Relationships
SQPPackage --> Settings : uses
SQPPackage --> Stats : returns
SQPPackage --> SQPMethodCore : contains

SQPMethodCore --> Settings : uses
SQPMethodCore --> Stats : creates
SQPMethodCore --> IterationData : creates
SQPMethodCore --> SOCResult : creates
SQPMethodCore --> QPInterfaceCore : uses
SQPMethodCore --> FilterLineSearchCore : uses
SQPMethodCore --> ConvexifyCore : uses
SQPMethodCore --> ResidualsCore : uses

Stats --> SQPStatus : contains

QPInterfaceCore --> AbstractQPSolver : creates
AbstractQPSolver <|-- ClarabelSolver
AbstractQPSolver <|-- OSQPSolver
AbstractQPSolver <|-- QuadraticModelsSolver
QPInterfaceCore --> QPResult : returns

FilterLineSearchCore --> Filter : uses
Filter --> FilterPoint : contains

' External Dependencies
ClarabelSolver --> Clarabel : uses
OSQPSolver --> OSQP : uses
QuadraticModelsSolver --> MadNLP : uses
SQPMethodCore --> NLPModels : uses
SQPMethodCore --> ADNLPModels : uses

note top of SQPPackage : Main entry point for\nSequential Quadratic Programming\noptimization solver

note right of Settings : Comprehensive configuration\nfor all solver parameters\nand strategies

note right of FilterLineSearchCore : Implements filter-based\nglobalization strategy\nfor robust convergence

note bottom of QPInterfaceCore : Unified interface to\nmultiple QP solvers\n(OSQP, Clarabel, etc.)

@enduml